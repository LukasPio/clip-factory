{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clip Factory",
  "version": "0.1.0",
  "identifier": "com.clipfactory.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Clip Factory","width":1366,"height":768,"minWidth":900,"minHeight":600}],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://127.0.0.1:*; media-src http://127.0.0.1:*; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {"active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"]}
}
